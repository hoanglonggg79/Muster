{
  "name": "muster-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend (React + TypeScript + Vite) for Muster",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "codegen": "cargo run --manifest-path ../../Cargo.toml -p muster-app --bin muster-codegen",
    "tauri": "tauri"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/cli": "~2.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
